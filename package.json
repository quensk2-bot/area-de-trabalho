    "motor:drive-worker": "npx tsx src/motor/cli/motorDriveWorkerCli.ts",
    "drive:setup-secrets": "node scripts/drive-setup-supabase-secrets.mjs",
    "drive:explore": "node scripts/drive-explore-tree.mjs",

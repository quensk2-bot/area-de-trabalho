    "motor:padronizar": "npx tsx src/motor/standardize/standardizeCli.ts",
    "motor:benchmark-streaming": "npx tsx src/motor/scripts/benchmarkStreaming.ts",
    "motor:piloto": "npx tsx src/motor/cli/motorPilotCli.ts",
    "motor:revalidacao": "npx tsx src/motor/cli/motorRevalidacaoCli.ts",
    "motor:piloto-revalidar": "npx tsx src/motor/cli/motorPilotoRevalidarCli.ts",
    "motor:persistencia-teste": "npx tsx src/motor/scripts/persistenciaTesteControlado.ts",
